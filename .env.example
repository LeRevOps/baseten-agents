# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Salesforce: External Client App with Client Credentials flow enabled
SF_LOGIN_URL=https://YOUR-DOMAIN.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Slack app (bot token + signing secret)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_REVOPS_CHANNEL_ID=        # fallback channel when no rep or low confidence

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Clay (optional; leave blank to skip enrichment)
CLAY_WEBHOOK_URL=
CLAY_CALLBACK_SECRET=make-up-a-long-random-string   # Clay sends this as the x-callback-secret header

# Public base URL (your Vercel URL, or an ngrok URL locally) for callbacks
APP_BASE_URL=http://localhost:3000

# Protects the scan endpoint (Vercel cron sends this as a Bearer token).
# Required: the endpoint rejects every request while this is empty. Use a long random string.
CRON_SECRET=

# Seeding: map all demo accounts to you
REP_SFDC_USER_ID=005...
REP_SLACK_USER_ID=U...
REP_NAME=Demo Rep
